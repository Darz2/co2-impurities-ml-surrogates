{
    "workbench.colorCustomizations": {
        "editorCursor.foreground": "#FF3B3B",
        "editorCursor.background": "#FFFFFF",
        "terminalCursor.foreground": "#FF3B3B",
        "terminalCursor.background": "#FFFFFF",
        "sideBar.foreground": "#EDEDED",
        "sideBarTitle.foreground": "#FFFFFF",
        "sideBarSectionHeader.foreground": "#FFFFFF",
        "list.foreground": "#EDEDED",
        "list.hoverForeground": "#FFFFFF",
        "list.activeSelectionForeground": "#FFFFFF",
        "list.inactiveSelectionForeground": "#EDEDED",
        "descriptionForeground": "#C8C8C8"
    },
    "latex-workshop.latex.autoBuild.run": "never",
    "github.copilot.enable": {
        "*": true,
        "latex": false,
        "tex": false,
        "bibtex": false,
        "plaintext": false,
        "markdown": false
    },
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk-draft",
            "command": "latexmk",
            "args": [
                "-pdf",
                "-interaction=nonstopmode",
                "-synctex=1",
                "-usepretex=\\PassOptionsToPackage{draft}{graphicx}",
                "%DOC%"
            ]
        },
        {
            "name": "latexmk-full",
            "command": "latexmk",
            "args": [
                "-pdf",
                "-interaction=nonstopmode",
                "-synctex=1",
                "%DOC%"
            ]
        }
    ],
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk draft (fast, no figures)",
            "tools": ["latexmk-draft"]
        },
        {
            "name": "latexmk (full, with figures)",
            "tools": ["latexmk-full"]
        }
    ]
}
